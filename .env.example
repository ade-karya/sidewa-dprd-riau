# ─────────────────────────────────────────────────────────────
# SIDEWA — contoh konfigurasi lingkungan
# Salin menjadi .env lalu sesuaikan. Jangan commit .env asli.
# ─────────────────────────────────────────────────────────────

# Identitas aplikasi
SIDEWA_ENV=development
SIDEWA_DEBUG=false
SIDEWA_BASE_URL=http://localhost:8000
SIDEWA_TIMEZONE=Asia/Jakarta

# WAJIB di produksi: minimal 32 karakter acak.
# Buat dengan: python -c "import secrets; print(secrets.token_urlsafe(48))"
SIDEWA_SECRET_KEY=ganti-dengan-kunci-rahasia-panjang-dan-acak

# Database. SQLite untuk pengembangan, PostgreSQL/Supabase untuk produksi.
# Untuk mode langsung Supabase, isi dengan transaction pooler (port 6543).
SIDEWA_DATABASE_URL=sqlite:///data/sidewa.db
# SIDEWA_DATABASE_URL=postgresql+psycopg://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require

# ── Supabase: database utama (opsional bila SIDEWA_DATABASE_URL langsung) ──
# Runtime memakai transaction pooler (6543); skema/resync memakai
# session pooler (5432). Jangan memakai service role key di sini.
SIDEWA_SUPABASE_DATABASE_URL=
# postgresql+psycopg://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require
SIDEWA_SUPABASE_ADMIN_DATABASE_URL=
# postgresql+psycopg://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require

# Sinkronisasi cache lokal → Supabase (hanya untuk mode cache lokal).
# Matikan bila SIDEWA_DATABASE_URL sudah langsung ke Supabase.
SIDEWA_SYNC_ENABLED=false
SIDEWA_SYNC_INTERVAL=5
SIDEWA_SYNC_BATCH=200
SIDEWA_SYNC_HYDRATE_ON_EMPTY=true
SIDEWA_SYNC_PULL_ON_START=false

# ── Media: Hugging Face S3 (S3-compatible) via boto3 ─────────
SIDEWA_HF_S3_BUCKET=
SIDEWA_HF_S3_ENDPOINT=
SIDEWA_HF_S3_REGION=us-east-1
SIDEWA_HF_S3_ACCESS_KEY_ID=
SIDEWA_HF_S3_SECRET_ACCESS_KEY=
SIDEWA_HF_S3_PREFIX=sidewa/media
SIDEWA_MEDIA_SYNC_ENABLED=false
SIDEWA_MEDIA_SYNC_INTERVAL=30
SIDEWA_MEDIA_CACHE_ON_DEMAND=true

# Drive Humas (folder drive/ di HF S3)
# Bucket publik agar tautan berkas bisa dibagikan langsung
# (kosong = ikut SIDEWA_HF_S3_BUCKET).
SIDEWA_DRIVE_BUCKET=sidewa-production
SIDEWA_DRIVE_ENABLED=true
SIDEWA_DRIVE_MAX_UPLOAD_MB=90
# Kuota Drive pribadi per pengguna (GB)
SIDEWA_DRIVE_QUOTA_GB=100

# Penyimpanan media privat
SIDEWA_MEDIA_ROOT=data/media
SIDEWA_MAX_UPLOAD_MB=15
SIDEWA_MAX_PHOTOS=12
SIDEWA_MAX_IMAGE_PIXELS=40000000

# Sesi & cookie
SIDEWA_SESSION_MAX_AGE=28800
SIDEWA_COOKIE_SECURE=true

# Mesin wajah: hog (CPU) atau cnn (GPU/akurasi lebih tinggi)
SIDEWA_FACE_DETECTOR=hog
SIDEWA_FACE_UPSAMPLE=1
SIDEWA_FACE_TOLERANCE=0.60
SIDEWA_FACE_AUTO_TAG=0.45
SIDEWA_FACE_REVIEW=0.58
# Selisih jarak maksimum terhadap kandidat terbaik per wajah.
# Nilai kecil = hasil lebih ketat dan lebih sedikit positif palsu.
SIDEWA_FACE_MATCH_MARGIN=0.08
SIDEWA_FACE_WORKERS=2
SIDEWA_FACE_MAX_DIM=1400
# Proses sinkron saat unggah (hanya untuk demo kecil)
SIDEWA_FACE_SYNC=false

# Face ID login anggota dewan (ambang khusus login, terpisah dari pencarian wajah)
SIDEWA_FACE_LOGIN_TOLERANCE=0.50
SIDEWA_FACE_LOGIN_MARGIN=0.03

# ── Tavily: pemindaian sentimen pemberitaan media online ─────
# Dapatkan API key di https://app.tavily.com — biarkan kosong untuk menonaktifkan.
SIDEWA_TAVILY_API_KEY=
SIDEWA_TAVILY_API_URL=https://api.tavily.com/search
SIDEWA_TAVILY_SEARCH_DEPTH=advanced
SIDEWA_TAVILY_MAX_RESULTS=10
SIDEWA_TAVILY_DAYS=180

# ── Gemini: analisis relevansi & sentimen (dipadukan dengan Tavily) ──
# Dapatkan API key di https://aistudio.google.com/apikey
# Tanpa key, sentimen tetap dihitung dengan leksikon lokal.
SIDEWA_GEMINI_API_KEY=
SIDEWA_GEMINI_API_URL=https://generativelanguage.googleapis.com/v1beta
SIDEWA_GEMINI_MODEL=gemini-3.5-flash-lite
# Asisten presentasi (Live API, WebSocket audio dua arah).
SIDEWA_GEMINI_LIVE_ENABLED=true
SIDEWA_GEMINI_LIVE_MODEL=gemini-3.8-live
# Pertanyaan teknis otomatis dialihkan ke model extended thinking.
SIDEWA_GEMINI_LIVE_TECHNICAL_MODEL=gemini-3.8-live-extended-thinking
# Tingkat penalaran untuk model teknis: low | medium | high.
# `low` paling stabil untuk percakapan langsung; level lebih tinggi bisa lebih lambat.
SIDEWA_GEMINI_LIVE_THINKING_LEVEL=low
SIDEWA_GEMINI_LIVE_VOICE=Aoede
SIDEWA_GEMINI_TIMEOUT=60
SIDEWA_GEMINI_MAX_OUTPUT_TOKENS=4096
SIDEWA_GEMINI_ANALYSIS_ENABLED=true
# Minta Gemini menyusun kueri Tavily yang lebih tepat.
SIDEWA_GEMINI_REFINE_QUERY=true
# Buang artikel yang menurut Gemini tidak membahas anggota tersebut.
SIDEWA_GEMINI_FILTER_IRRELEVANT=true
# Bobot skor Gemini terhadap skor leksikon (0.0-1.0).
SIDEWA_GEMINI_SCORE_WEIGHT=0.7

# ── Resolusi identitas: pastikan berita tentang orang yang benar ──
# Gemini mencocokkan nama/variasi/gelar + instansi + lokasi + jabatan +
# rentang tahun + akun resmi. Nama saja tidak cukup.
# Berkas JSON opsional berisi alias/akun resmi per ID anggota.
# Contoh: docs/member_identity.example.json → salin ke data/member_identity.json
SIDEWA_MEMBER_IDENTITY_FILE=data/member_identity.json
# Tahun terbit paling lama yang masih relevan (0 = tanpa batas bawah).
SIDEWA_SENTIMENT_YEAR_FROM=2024
# Tahun terbit paling baru (0 = tahun berjalan + 1).
SIDEWA_SENTIMENT_YEAR_TO=0
# Lokasi/dapil bawaan bila anggota tidak punya dapil di database.
SIDEWA_SENTIMENT_LOCATION=Provinsi Riau
# Skor identitas minimum Gemini agar berita diterima (0.0-1.0).
SIDEWA_GEMINI_MIN_IDENTITY_SCORE=0.65
# true: berita tanpa identitas terkonfirmasi ditolak.
SIDEWA_GEMINI_REQUIRE_IDENTITY=true

# ── Seleksi foto AI Humas ──
# Aktifkan ruang kerja kurasi foto berbantuan Gemini.
SIDEWA_PHOTO_SELECTION_ENABLED=true
# Model default. Setiap pengguna tetap memakai kunci API Gemini sendiri.
SIDEWA_PHOTO_SELECTION_MODEL=gemini-3.5-flash-lite
# Batas kuota awal per pengguna (dapat diubah di UI).
SIDEWA_PHOTO_SELECTION_RPM=15
SIDEWA_PHOTO_SELECTION_TPM=250000
SIDEWA_PHOTO_SELECTION_RPD=500
# Batas jumlah foto per sesi (unggah). Pemrosesan Gemini mengikuti RPM/TPM/RPD.
SIDEWA_PHOTO_SELECTION_MAX_PHOTOS=24
SIDEWA_PHOTO_SELECTION_WORKERS=1
SIDEWA_PHOTO_SELECTION_TIMEOUT=90
# true hanya untuk pengujian: proses seleksi berjalan sinkron.
SIDEWA_PHOTO_SELECTION_SYNC=false

# Demo: tampilkan data & akun contoh. Matikan di produksi.
SIDEWA_DEMO_MODE=false

# CATATAN: perintah seed/seed-staff/resync diblokir total saat SIDEWA_ENV=production.
# Data production di Supabase dan HF S3 tidak pernah diisi ulang otomatis.

# Superadmin bootstrap (dibuat sekali saat database kosong)
SIDEWA_BOOTSTRAP_ADMIN_USERNAME=superadmin
SIDEWA_BOOTSTRAP_ADMIN_PASSWORD=GantiSandi#Kuat2026
SIDEWA_BOOTSTRAP_ADMIN_NAME=Administrator SIDEWA

# Keamanan tambahan
SIDEWA_TRUSTED_HOSTS=sidewa.dprd.riau.go.id,localhost,127.0.0.1
SIDEWA_CORS_ORIGINS=
SIDEWA_METRICS_TOKEN=
SIDEWA_LOG_LEVEL=INFO
